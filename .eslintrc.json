{
	"extends": [
		"wikimedia/client/es6",
		"wikimedia/jquery",
		"wikimedia/mediawiki"
	],
	"globals": {
		"mw": "readonly"
	},
	"rules": {
		"max-len": "off",
		"no-bitwise": "off",
		"no-jquery/no-each-util": "off",
		"no-jquery/no-global-selector": "off",
		"no-jquery/no-sizzle": "off",
		"no-shadow": "off",
		"security/detect-unsafe-regex": "off"
	}
}
